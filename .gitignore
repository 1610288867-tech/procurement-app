# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# ---- 环境变量：绝不进 Git ----
.env
.env.local

# ---- 附件目录（M7 起用）----
backend/uploads/

# ---- pip 被中断时留在当前目录的临时目录 ----
# pip 正常运行会自己清掉；中途 Ctrl+C 或被杀掉就会留下 pip-install-* / pip-unpack-* 等，
# 里面可能有几百 KB 的 .whl。加一条兜底，避免误提交。
pip-*/

# ---- 前端 ----
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
*.local
.vite/

# ---- 编辑器"原子写"留下的临时目录 ----
# 保存文件时先写 `<名字>.<pid>.<uuid>.tmpdir/<名字>.tmp` 再改名，正常会自己清掉。
# 但 Vite 的文件监听器可能正好去 watch 这个瞬时文件，Windows 上抛 EBUSY 并
# **让整个 dev server 退出**（已在 vite.config.ts 的 server.watch.ignored 里排掉）。
# 这里再兜一层，避免误提交。
.*.tmpdir/
*.tmp

# ---- 浏览器实测截图（工具生成，不是交付物）----
browser-screenshots/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- 注意 ----
# 数据库数据不在这里：它在 D:\develop\procurement\data\postgres，
# 与代码仓库解耦（容器是容器，代码是代码）。
