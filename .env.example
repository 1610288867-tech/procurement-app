# 复制成 backend/.env 后按需修改。.env 不进 Git。
#
# 只有五项 —— 这是刻意的。原项目有 60 多个环境变量，不要一开始就抄。

DATABASE_URL=postgresql+asyncpg://app:devpassword@localhost:5432/procurement

# M3 起用。本地开发随便填，但不要把它带到任何真实环境。
JWT_SECRET=dev-only-change-me

# M9 起**真的有人读它**了：附件落盘的根目录，
# 使用者是 `infrastructure/object_store.py`（经 `boundaries/http/requests.py` 装配）。
# 这个目录**绝不要**挂成静态目录 —— 附件只能经带鉴权的下载路由出来。
UPLOAD_DIR=uploads

# M10 起用：**比价线**（单位：分）。金额 >= 这条线时，定标要求至少 3 家有效报价
# （家数常量在 `domain/sourcing_policy.MIN_QUOTATIONS`，不是配置）。
# 默认 1000000 分 = 1 万元，取自领域设计 5.3 的示例值。
# 它是**制度参数**（控制起点），不是业务常量：按公司的采购金额分布调整。
SOURCING_THRESHOLD_FEN=1000000

LOG_LEVEL=INFO

# 注意这里**没有** CORS_ORIGINS：
# 前端走 Vite 代理（同源），用不上 CORS。等 M12 打包成 APK、前后端真正分居
# 两个源时再加回来。
