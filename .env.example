# 复制成 backend/.env 后按需修改。.env 不进 Git。
#
# ⚠️ **必须放在 `backend/.env`**（不是仓库根）：`app/config.py` 的 `Settings` 是
# `env_file=".env"`，相对**工作目录**解析，而后端的工作目录是 `backend/`。
# 放在根目录的话它**不会被读到**，且不报错 —— 表现是"配了却没生效"。
#
# 数量：原来这个文件是 6 个键（正文那句"只有五项"写在 M10 加
# `SOURCING_THRESHOLD_FEN` 之前）。M11 加 AI 模块后变成 **14 个键**，
# 新增的 9 个全是模型接口与密钥（下面 `KNOWLEDGE_` 那一段）。
# 那段非加不可的理由：没有它就接不上模型，而"接不上模型"时系统只会退回
# 抽取式兜底、**不报配置错误** —— 于是"配错了"与"没配"看起来一模一样。

DATABASE_URL=postgresql+asyncpg://app:devpassword@localhost:5432/procurement

# M3 起用。本地开发随便填，但不要把它带到任何真实环境。
JWT_SECRET=dev-only-change-me

# M9 起**真的有人读它**了：附件落盘的根目录，
# 使用者是 `infrastructure/object_store.py`（经 `boundaries/http/requests.py` 装配）。
# 这个目录**绝不要**挂成静态目录 —— 附件只能经带鉴权的下载路由出来。
UPLOAD_DIR=uploads

# M10 起用：**比价线**（单位：分）。金额 >= 这条线时，定标要求至少 3 家有效报价
# （家数常量在 `domain/sourcing_policy.MIN_QUOTATIONS`，不是配置）。
# 默认 1000000 分 = 1 万元，取自领域设计 5.3 的示例值。
# 它是**制度参数**（控制起点），不是业务常量：按公司的采购金额分布调整。
SOURCING_THRESHOLD_FEN=1000000

LOG_LEVEL=INFO

# ---------------------------------------------------------------- M11 · 对话模型（Agent 用）
# 这三项齐了才会选中 `OpenAiCompatibleChat`（它 `supports_tools=True`，
# 也就是**只有这时 Agent 的 Function Calling 才会开**）。
# 缺任何一项都会退回本地抽取式兜底：那时问"我提过哪些采购申请"这类业务数据问题，
# 只会得到"制度中没有找到相关规定" —— 实测就是这个表现。
# 默认值对应本机 Ollama，模型目录见 scripts/ollama.ps1（项目内 .ollama/models）。
KNOWLEDGE_LLM_BASE_URL=http://127.0.0.1:11434/v1
KNOWLEDGE_LLM_API_KEY=ollama
KNOWLEDGE_LLM_MODEL=qwen2.5-3b-instruct

# 模型价格表（**元/百万 token**，格式 `输入,输出`，多组用 `;` 分隔）。
# **空 = 不知道价格 → 成本记 NULL**，这是刻意的：本地模型写 `0,0`，
# 因为"确实不花钱"与"不知道花多少"在数据里必须区分（见 `domain/cost.py`）。
# 示例：qwen2.5-3b-instruct=0,0;gpt-4o-mini=0.15,0.6
KNOWLEDGE_LLM_PRICES=qwen2.5-3b-instruct=0,0

# ---------------------------------------------------------------- M11 · embedding（检索向量）
# `ollama` 走真模型（默认），`local` 是离线哈希兜底（仅测试/无模型时用）。
# ⚠️ 换 provider 或模型 = **换了一套向量空间**：已有片段的向量必须重新入库，
# 否则检索质量会静默变差（不会报错）。对比数字见 docs/AI-评测baseline.md。
KNOWLEDGE_EMBEDDING_PROVIDER=ollama
# 与 `KNOWLEDGE_LLM_BASE_URL` **刻意分开**：两者的地址常常不是一个
# （对话模型可能在云端，embedding 在本地）。
KNOWLEDGE_EMBEDDING_BASE_URL=http://127.0.0.1:11434
KNOWLEDGE_EMBEDDING_MODEL=quentinz/bge-small-zh-v1.5

# 检索相似度下限。0.50 是按 27 条 Golden QA **实测标定**的，不是拍的：
# 0.55 会造成 3 条"本可回答却拒答"。标定过程与两套对比数字见
# `backend/scripts/knowledge_eval.py` 的 GATES 注释与 docs/AI-评测baseline.md。
KNOWLEDGE_MIN_SCORE=0.50

# "依据够不够硬"的**第二道线**：顶分 ≥ 它 → 直接用制度片段回答；
# 落在 [KNOWLEDGE_MIN_SCORE, 它) → **先让 Agent 试一次**（它可能查得到真实数据），
# 一个工具都没调就落回制度问答。
#
# 为什么需要第二道线：实测业务数据问题与制度问题的顶分**是重叠的** ——
# "我提过哪些采购申请？"（业务，0.624）比"廉洁从业禁止哪些行为？"（制度，0.584）还高。
# 既然分不开，就看**答错的代价**：拿制度片段答业务问题是"看起来像回答"（最糟），
# 让 Agent 处理制度问题只是**诚实拒答**（安全一侧）。
#
# 取 0.70 的依据：10 份种子制度里顶分高于它的问句（0.703~0.771）都是"该用制度答"的。
# ⚠️ 换 embedding 或扩语料后要**重新标定这个数**（与 KNOWLEDGE_MIN_SCORE 同理）。
# ⚠️ 它**不能小于** KNOWLEDGE_MIN_SCORE —— 那样弱依据那条分支永远走不到，
#    装配时会直接报 500（KNOWLEDGE_THRESHOLDS_INVERTED）。
KNOWLEDGE_STRONG_SCORE=0.70

# 检索返回的片段条数（进上下文的主体就是它们，直接影响 token 与配额）。
KNOWLEDGE_TOP_K=5

# 注意这里**没有** CORS_ORIGINS：
# 前端走 Vite 代理（同源），用不上 CORS。等 M12 打包成 APK、前后端真正分居
# 两个源时再加回来。
